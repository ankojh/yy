# Copy to backend/.env to configure live model calls. That file is gitignored.

# OpenAI independently commands both islands. Each private request selects one action
# from the server's legal candidates and writes its short public declaration.
# Without this key, both commanders use the deterministic local policy.
# OPENAI_API_KEY=sk-proj-...

# Jev independently adjudicates the two completed actions from the true state.
# Without this key, the Arbiter uses its bounded local fallback.
# TYPESAFE_API_KEY=tsf-...

# Optional neural island voices. Cloudflare Workers AI includes a daily free allocation;
# create a Workers AI token and copy the account ID from its REST API setup page.
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_API_TOKEN=...
# TTS_VOICE_WEST=atlas
# TTS_VOICE_EAST=jupiter

# Optional preferred speech provider. Copy Key 1 or Key 2 and the region from the
# Azure Speech resource's Keys and Endpoint page. Both default voices support angry SSML.
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=northcentralus
# AZURE_SPEECH_VOICE_WEST=en-US-JennyNeural
# AZURE_SPEECH_VOICE_EAST=en-US-GuyNeural

# APP_ENV=development

# Optional — defaults shown.
# WEST_MODEL=gpt-5-nano
# EAST_MODEL=gpt-4.1-nano
# JEV_MODEL=jev-latest
# MAX_TURNS=12
# REVEAL=9.0
# TURN_PAUSE=2.0
# BEAT=0.3

# Raw prompt/response JSONL files: on in development, off in production.
# LLM_DEBUG=0

# Set to 1 to force scripted agents even with a valid key.
# MOCK=1
