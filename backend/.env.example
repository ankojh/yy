# Copy to backend/.env to override the local defaults. That file is gitignored.

# Development uses the local Ollama service and the installed Gemma model by default.
# APP_ENV=development
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=gemma4:26b

# Hosted deployments opt in explicitly. Commanders use the Responses API; the arbiter
# uses a separate stateless Responses request. Local Ollama remains on Chat Completions.
# APP_ENV=production
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...

# Optional — defaults shown.
# WEST_MODEL=gpt-5-nano
# EAST_MODEL=gpt-4.1-nano
# ARBITER_MODEL=gpt-5-nano
# MAX_TURNS=12
# RESPONSE_CHAIN_TURNS=4

# Raw prompt/response JSONL files: on in development, off in production.
# LLM_DEBUG=0

# Set to 1 to force scripted agents even with a valid key.
# MOCK=1
