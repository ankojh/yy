# Copy to backend/.env to configure live model calls. That file is gitignored.

# Commanders use the OpenAI Responses API; the arbiter uses a separate stateless
# Responses request. Without this key, the backend uses scripted agents.
# OPENAI_API_KEY=sk-proj-...

# Optional neural island voices. Cloudflare Workers AI includes a daily free allocation;
# create a Workers AI token and copy the account ID from its REST API setup page.
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_API_TOKEN=...
# TTS_VOICE_WEST=atlas
# TTS_VOICE_EAST=jupiter

# Optional preferred provider for explicitly aggressive delivery. ElevenLabs v3 uses
# performance tags; copy two voice IDs from your account's My Voices page.
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_WEST=...
# ELEVENLABS_VOICE_EAST=...

# APP_ENV=development

# Optional — defaults shown.
# WEST_MODEL=gpt-5-nano
# EAST_MODEL=gpt-4.1-nano
# ARBITER_MODEL=gpt-5-nano
# MAX_TURNS=12
# RESPONSE_CHAIN_TURNS=4

# Raw prompt/response JSONL files: on in development, off in production.
# LLM_DEBUG=0

# Set to 1 to force scripted agents even with a valid key.
# MOCK=1
