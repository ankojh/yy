# Copy to backend/.env and fill in. That file is gitignored.
# Key needs one permission: Model capabilities -> Chat Completions -> Request.

OPENAI_API_KEY=sk-proj-...

# Optional — defaults shown.
# NATION_MODEL=gpt-5-nano
# ARBITER_MODEL=gpt-5-nano
# MAX_TURNS=12

# Set to 1 to force scripted agents even with a valid key.
# MOCK=1
